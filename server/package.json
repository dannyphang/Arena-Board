{
  "name": "arena-board-backend",
  "version": "1.5.2",
  "private": true,
  "type": "module",
  "description": "ArenaBoard backend & real-time WebSocket server",
  "scripts": {
    "start": "tsx src/standalone.ts",
    "dev": "tsx src/standalone.ts",
    "build": "esbuild src/standalone.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.4",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
