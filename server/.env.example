# Render Backend Environment Configuration
PORT=3000
NODE_ENV=production

# The allowed Vercel frontend origin (or comma-separated list of origins, or * for all)
# Example: https://arenaboard.vercel.app,https://arenaboard-git-main-yourname.vercel.app
CLIENT_ORIGIN=*

# Standalone server flag (Render automatically sets RENDER=true, but you can also set this)
STANDALONE_SERVER=true
